# ── .env.azure — set ALL of these as Azure App Service → Configuration → App Settings ──
# Do NOT commit real values.

APP_NAME=Mesbanati
APP_ENV=production
APP_KEY=            # generate with: php artisan key:generate --show
APP_DEBUG=false
APP_URL=https://your-api.azurewebsites.net

# Production frontend (Azure Static Web App URL)
FRONTEND_URL=https://your-frontend.azurestaticapps.net

LOG_CHANNEL=stack
LOG_LEVEL=error

# Azure Database for MySQL
DB_CONNECTION=mysql
DB_HOST=your-server.mysql.database.azure.com
DB_PORT=3306
DB_DATABASE=mesbana
DB_USERNAME=your_user@your-server
DB_PASSWORD=your_password

CACHE_DRIVER=file
FILESYSTEM_DISK=public
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=your_email@gmail.com
MAIL_FROM_NAME="Mesbanati"
